# Copy this file to .env and fill in real values. .env is gitignored --
# never commit secrets.
#
# Compose Manager keeps its own project files on the unRAID flash drive, so
# compose-relative paths won't resolve to this repo. Everything below is an
# absolute path for that reason.

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Where this repo is checked out on the unRAID host.
REPO_DIR=/mnt/user/appdata/blog/repo

# Host directory for persistent data/logs (Listmonk DB, Shiny logs, etc.).
APPDATA_DIR=/mnt/user/appdata/blog

# Directory nginx serves the built site from (populated by build.sh).
BLOG_PUBLIC=/mnt/user/appdata/blog/public

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# Name of the external Docker network shared with the cloudflared tunnel
# container. Must already exist (docker network create blog-net) and match
# the network your cloudflared container is attached to.
DOCKER_NETWORK=blog-net

# LAN-only port for the Listmonk admin UI/API. Do not expose this through
# the tunnel -- only bind it to your LAN/VPN interface, e.g. 192.168.1.10:9000.
LISTMONK_ADMIN_BIND=127.0.0.1:9000

# Optional LAN-only port for hitting Shiny directly (bypassing nginx/tunnel)
# while developing an app. Leave unset/commented to not publish it at all.
# SHINY_BIND=127.0.0.1:3838

# ---------------------------------------------------------------------------
# Listmonk
# ---------------------------------------------------------------------------

LISTMONK_DB_USER=listmonk
LISTMONK_DB_PASSWORD=change-me-to-a-long-random-value
LISTMONK_DB_NAME=listmonk

# Only used by the one-shot `setup` profile installer on first run.
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=change-me-to-a-long-random-value
LISTMONK_ADMIN_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Shiny
# ---------------------------------------------------------------------------

# GitHub owner used for the pre-built shiny-plotly image tag. Only matters
# if you pull the GHCR image instead of building docker/shiny locally.
GITHUB_OWNER=eguthriewastaken
